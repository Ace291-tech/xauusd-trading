//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  Orochi-Style All-In-One  ·  VWAP Suite · TPO · Key Levels · Volume Delta/OI
//  Original code written from scratch for ZERK (XAUUSD). Not affiliated with
//  Orochi Trading. Visual defaults mimic the public Orochi product screenshots
//  (TradingView default palette on a dark #252525-style chart).
// ═══════════════════════════════════════════════════════════════════════════
indicator("Orochi-Style All-In-One (VWAP · TPO · Key Levels · Delta)", shorttitle = "OS-AIO", overlay = true, max_lines_count = 500, max_boxes_count = 500, max_labels_count = 500, max_bars_back = 5000)

