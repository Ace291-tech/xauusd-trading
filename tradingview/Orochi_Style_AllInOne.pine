lblSzOf(string s) =>
    switch s
        "Tiny" => size.tiny
        "Small" => size.small
        "Large" => size.large
        => size.normal
string lblSz = lblSzOf(eLblName)

fmtPrice(float p) =>
    string s = str.tostring(p, format.mintick)
    int dot = str.pos(s, ".")
    string whole = dot >= 0 ? str.substring(s, 0, dot) : s
    string frac = dot >= 0 ? str.substring(s, dot) : ""
    bool neg = str.startswith(whole, "-")
    string digs = neg ? str.substring(whole, 1) : whole
    string out = ""
    int len = str.length(digs)
    if len > 0
        for i = 0 to len - 1
            int idx = len - 1 - i
            string ch = str.substring(digs, idx, idx + 1)
            if i > 0 and i % 3 == 0
                out := "," + out
            out := ch + out
    else
        out := "0"
    (neg ? "-" : "") + out + frac

fmtVol(float v) =>
    float a = math.abs(nz(v))
    string sgn = v < 0 ? "-" : ""
    string b = a >= 1000000 ? str.tostring(a / 1000000.0, "#.#") + "M" : a >= 1000 ? str.tostring(a / 1000.0, "#.#") + "K" : str.tostring(a, format.volume)
    sgn + b

clampX(int x) =>
    math.max(x, bar_index - 4990)

// ── Төрлүүд ──
type Lvl
    float price
    string txt
    string pre
    string kind
    color col
    int x2
    string lstyle
    int lwidth
    bool drawLine
    int grp
    int rank
    string tip

type VW
    float sPV = 0.0
    float sPV2 = 0.0
    float sV = 0.0
    float vw = na
    float sd = na
    float pvw = na
    float psd = na
    int start = 0
    int pStart = 0
    int pEnd = -1

type Naked
    float[] p
    int[] x

type KL
    float op = na
    float cH = na
    float cL = na
    int start = 0
    int pstart = 0

type Sess
    float h = na
    float l = na
    int start = 0

type TpoS
    float[] curH
    float[] curL
    float blkH = na
    float blkL = na
    int lastBlk = na
    float poc = na
    float vah = na
    float val = na
    bool ready = false

method update(VW s, bool isNew, float src, float v) =>
    if isNew
        s.pvw := s.vw
        s.psd := s.sd
        s.pEnd := bar_index > 0 ? bar_index - 1 : -1
        s.pStart := s.start
        s.start := bar_index
        s.sPV := 0.0
        s.sPV2 := 0.0
        s.sV := 0.0
    s.sPV := s.sPV + src * v
    s.sPV2 := s.sPV2 + src * src * v
    s.sV := s.sV + v
    s.vw := s.sV > 0 ? s.sPV / s.sV : src
    s.sd := s.sV > 0 ? math.sqrt(math.max(s.sPV2 / s.sV - s.vw * s.vw, 0.0)) : 0.0
    s

method addN(Naked n, float price, int x, int cap) =>
    if not na(price) and cap > 0
        n.p.push(price)
        n.x.push(x)
        if n.p.size() > cap
            n.p.shift()
            n.x.shift()

method testN(Naked n, float hi, float lo) =>
    int sz = n.p.size()
    if sz > 0
        for i = sz - 1 to 0
            float v = n.p.get(i)
            if v <= hi and v >= lo
                n.p.remove(i)
                n.x.remove(i)

newNaked() =>
    Naked.new(array.new<float>(), array.new<int>())

method roll(KL k, bool isNew, float htfOpen, Naked nk, int cap) =>
    if isNew
        if not na(k.op)
            nk.addN(k.op, k.start, cap)
        k.pstart := k.start
        k.start := bar_index
        k.cH := high
        k.cL := low
    else
        k.cH := na(k.cH) ? high : math.max(k.cH, high)
        k.cL := na(k.cL) ? low : math.min(k.cL, low)
    k.op := htfOpen
    nk.testN(high, low)
    k

method track(Sess s, bool inS, bool inPrev) =>
    if inS and not inPrev
        s.h := high
        s.l := low
        s.start := bar_index
    else if inS
        s.h := math.max(s.h, high)
        s.l := math.min(s.l, low)
    s

// TPO: үнийн мөр бүрт хэдэн блок хүрснийг тоолж POC, VAH, VAL гаргана.
tpoCalc(float[] hs, float[] ls, int rows, float vaPct) =>
    float[] cnt = array.new<float>(rows, 0.0)
    float lo = ls.size() > 0 ? ls.min() : na
    float hi = hs.size() > 0 ? hs.max() : na
    float step = na(hi) or na(lo) ? na : math.max((hi - lo) / rows, syminfo.mintick)
    int pocI = 0
    int vahI = 0
    int valI = 0
    if not na(step)
        for i = 0 to hs.size() - 1
            int b0 = math.max(0, math.min(rows - 1, int(math.floor((ls.get(i) - lo) / step))))
            int b1 = math.max(0, math.min(rows - 1, int(math.floor((hs.get(i) - lo) / step))))
            for b = b0 to b1
                cnt.set(b, cnt.get(b) + 1.0)
        float mx = cnt.max()
        float bestDist = 1e10
        for b = 0 to rows - 1
            if cnt.get(b) == mx
                float dist = math.abs(b - (rows - 1) / 2.0)
                if dist < bestDist
                    bestDist := dist
                    pocI := b
        float total = cnt.sum()
        float acc = cnt.get(pocI)
        int up = pocI
        int dn = pocI
        while acc < total * vaPct and (up < rows - 1 or dn > 0)
            float nu = up < rows - 1 ? cnt.get(up + 1) : -1.0
            float nd = dn > 0 ? cnt.get(dn - 1) : -1.0
            if nu >= nd and up < rows - 1
                up += 1
                acc += math.max(nu, 0.0)
            else if dn > 0
                dn -= 1
                acc += math.max(nd, 0.0)
            else
                break
        vahI := up
        valI := dn
    [cnt, lo, step, pocI, vahI, valI]

method step(TpoS s, bool isNew, int blk, int rows, float va) =>
    if isNew
        if not na(s.blkH)
            s.curH.push(s.blkH)
            s.curL.push(s.blkL)
        if s.curH.size() > 0
            [c_, lo_, st_, pI, hI, lI] = tpoCalc(s.curH, s.curL, rows, va)
            s.poc := lo_ + st_ * (pI + 0.5)
            s.vah := lo_ + st_ * (hI + 1)
            s.val := lo_ + st_ * lI
            s.ready := true
        s.curH.clear()
        s.curL.clear()
        s.blkH := high
        s.blkL := low
        s.lastBlk := blk
    else
        if na(s.lastBlk) or blk != s.lastBlk
            if not na(s.blkH)
                s.curH.push(s.blkH)
                s.curL.push(s.blkL)
            s.blkH := high
            s.blkL := low
            s.lastBlk := blk
        else
            s.blkH := math.max(s.blkH, high)
            s.blkL := math.min(s.blkL, low)
    s

// Зургийн сав. Сүүлийн баар дээр цэвэрлээд дахин зурна.
var line[] gLines = array.new<line>()
var label[] gLabels = array.new<label>()
var box[] gBoxes = array.new<box>()
var float[] hBins = array.new<float>()
var int[] hN = array.new<int>()
var float[] hLo = array.new<float>()
var float[] hStep = array.new<float>()
var int[] hPocI = array.new<int>()
var int[] hVahI = array.new<int>()
var int[] hValI = array.new<int>()
var int[] hX0 = array.new<int>()
var int[] hX1 = array.new<int>()
var float[] hPoc = array.new<float>()
var float[] hVah = array.new<float>()
var float[] hVal = array.new<float>()
var float[] spTop = array.new<float>()
var float[] spBot = array.new<float>()
var int[] spX0 = array.new<int>()
var int[] spX1 = array.new<int>()
var float[] spMax = array.new<float>()
var float[] spMin = array.new<float>()
var float[] bH = array.new<float>()
var float[] bL = array.new<float>()
var float[] bV = array.new<float>()
var int[] bX = array.new<int>()
var int[] bSes = array.new<int>()
var int[] bDay = array.new<int>()
var int[] bWeek = array.new<int>()
var int[] bMon = array.new<int>()
var int[] bYear = array.new<int>()
var int[] bubX = array.new<int>()
var float[] bubY = array.new<float>()
var float[] bubDlt = array.new<float>()
var int[] bubS = array.new<int>()
var TpoS tW = TpoS.new(array.new<float>(), array.new<float>())
var TpoS tM = TpoS.new(array.new<float>(), array.new<float>())

saveHist(float[] cnt, float lo, float step, int pI, int hI, int lI, int x0, int x1, float poc, float vah, float val) =>
    int r = cnt.size()
    if r > 0 and not na(lo)
        for i = 0 to r - 1
            hBins.push(cnt.get(i))
        hN.push(r)
        hLo.push(lo)
        hStep.push(step)
        hPocI.push(pI)
        hVahI.push(hI)
        hValI.push(lI)
        hX0.push(x0)
        hX1.push(x1)
        hPoc.push(poc)
        hVah.push(vah)
        hVal.push(val)
        while hN.size() > 8
            int drop = hN.shift()
            hLo.shift()
            hStep.shift()
            hPocI.shift()
            hVahI.shift()
            hValI.shift()
            hX0.shift()
            hX1.shift()
            hPoc.shift()
            hVah.shift()
            hVal.shift()
            if drop > 0 and hBins.size() >= drop
                for j = 0 to drop - 1
                    hBins.shift()
    r

pushZone(float top, float bot, int x0) =>
    spTop.push(top)
    spBot.push(bot)
    spX0.push(x0)
    spX1.push(0)
    spMax.push(high)
    spMin.push(low)
    while spTop.size() > 24
        spTop.shift()
        spBot.shift()
        spX0.shift()
        spX1.shift()
        spMax.shift()
        spMin.shift()
    0

saveSingles(float[] cnt, float lo, float step) =>
    int rows = cnt.size()
    if singlesOn and rows > 2 and not na(step)
        int b = 1
        while b < rows - 1
            if cnt.get(b) == 1.0
                int e = b
                while e + 1 < rows - 1 and cnt.get(e + 1) == 1.0
                    e += 1
                pushZone(lo + step * (e + 1), lo + step * b, bar_index > 0 ? bar_index - 1 : bar_index)
                b := e + 1
            else
                b += 1
    0

float atr14 = ta.atr(14)
float vol = na(volume) or volume <= 0 ? 1.0 : volume

// ── 1 · VWAP. Дундаж шугам нь VWAP, ±1σ нь VAH/VAL. ──
bool newD = timeframe.change("D")
bool newW = timeframe.change("W")
bool newM = timeframe.change("M")
bool newQ = timeframe.change("3M")
bool newY = timeframe.change("12M")
var VW vD = VW.new()
var VW vW = VW.new()
var VW vM = VW.new()
var VW vQ = VW.new()
var VW vY = VW.new()
vD.update(newD, vwSrc, vol)
vW.update(newW, vwSrc, vol)
vM.update(newM, vwSrc, vol)
vQ.update(newQ, vwSrc, vol)
vY.update(newY, vwSrc, vol)
float dVW = vD.vw
float wVW = vW.vw
float mVW = vM.vw
float qVW = vQ.vw
float yVW = vY.vw
bool drawVw = not lblOnly
plot(drawVw and eShowD and not newD ? dVW : na, "Daily VWAP", eColD, 1, dStyle == "Circles" ? plot.style_circles : plot.style_linebr)
plot(drawVw and eShowW and not newW ? wVW : na, "Weekly VWAP", eColW, 1, plot.style_linebr)
plot(drawVw and eShowM and not newM ? mVW : na, "Monthly VWAP", eColM, 1, plot.style_linebr)
plot(drawVw and eShowQ and not newQ ? qVW : na, "Quarterly VWAP", eColQ, 1, plot.style_linebr)
plot(drawVw and eShowY and not newY ? yVW : na, "Yearly VWAP", eColY, 1, plot.style_linebr)

float bVW = switch eAnchor
    "Weekly" => wVW
    "Monthly" => mVW
    "Quarterly" => qVW
    "Yearly" => yVW
    => dVW
float bSD = switch eAnchor
    "Weekly" => vW.sd
    "Monthly" => vM.sd
    "Quarterly" => vQ.sd
    "Yearly" => vY.sd
    => vD.sd
bool bNew = switch eAnchor
    "Weekly" => newW
    "Monthly" => newM
    "Quarterly" => newQ
    "Yearly" => newY
    => newD
bool bShow = drawVw and bandsOn and not bNew
float bU1 = bVW + bSD * m1
float bL1 = bVW - bSD * m1
float bU2 = bVW + bSD * m2
float bL2 = bVW - bSD * m2
float bU3 = bVW + bSD * m3
float bL3 = bVW - bSD * m3
color band1 = color.new(bandLineCol, light ? 25 : 35)
color band2 = color.new(bandLineCol, light ? 45 : 60)
pU1 = plot(bShow and b1On ? bU1 : na, "Band +1σ VAH", band1, 1, plot.style_linebr)
pL1 = plot(bShow and b1On ? bL1 : na, "Band -1σ VAL", band1, 1, plot.style_linebr)
pU2 = plot(bShow and b2On ? bU2 : na, "Band +2σ", band2, 1, plot.style_circles)
pL2 = plot(bShow and b2On ? bL2 : na, "Band -2σ", band2, 1, plot.style_circles)
pU3 = plot(bShow and b3On ? bU3 : na, "Band +3σ", band2, 1, plot.style_circles)
pL3 = plot(bShow and b3On ? bL3 : na, "Band -3σ", band2, 1, plot.style_circles)
fill(pU1, pL1, f1On and drawVw ? bandFillCol : na, "Fill ±1σ")
fill(pU2, pU1, f2On and drawVw ? bandFillCol : na, "Fill +2σ")
fill(pL1, pL2, f2On and drawVw ? bandFillCol : na, "Fill -2σ")
fill(pU3, pU2, f3On and drawVw ? bandFillCol : na, "Fill +3σ")
fill(pL2, pL3, f3On and drawVw ? bandFillCol : na, "Fill -3σ")

rollVW(int n) =>
    float sv = math.sum(nz(volume), n)
    float spv = math.sum(hlc3 * nz(volume), n)
    sv > 0 ? spv / sv : na
[r7, r30, r90, r365] = request.security(syminfo.tickerid, "D", [rollVW(7)[1], rollVW(30)[1], rollVW(90)[1], rollVW(365)[1]], lookahead = barmerge.lookahead_on)
plot(drawVw and eR7 ? r7 : na, "Rolling 7D VWAP", eRoll, 1)
plot(drawVw and eR30 ? r30 : na, "Rolling 30D VWAP", eRoll, 1)
plot(drawVw and eR90 ? r90 : na, "Rolling 90D VWAP", eRoll, 1)
plot(drawVw and eR365 ? r365 : na, "Rolling 365D VWAP", eRoll, 1)

// ── 2 · TPO. Олон хаагдсан профайл + баруун талын хөгжиж буй профайл. ──
string tpoTF = switch eTpoPer
    "Weekly" => "W"
    "Monthly" => "M"
    => "D"
string tpoPrevTag = eTpoPer == "Weekly" ? "PW" : eTpoPer == "Monthly" ? "PM" : "PD"
string tpoCurTag = eTpoPer == "Weekly" ? "CW" : eTpoPer == "Monthly" ? "CM" : "CD"
bool tpoActive = eTpoOn and timeframe.in_seconds(timeframe.period) < timeframe.in_seconds(tpoTF)
var float[] curH = array.new<float>()
var float[] curL = array.new<float>()
var float blkH = na
var float blkL = na
var int lastBlk = na
var int curStart = 0
var float prvPOC = na
var float prvVAH = na
var float prvVAL = na
var int prvEnd = na
var Naked nPOC = newNaked()
int blkId = int(math.floor(time / (tpoMin * 60000.0)))
bool tpoNew = timeframe.change(tpoTF)
if tpoActive
    if tpoNew
        if not na(blkH)
            curH.push(blkH)
            curL.push(blkL)
        if curH.size() > 0
            [c_, lo_, st_, pI, hI, lI] = tpoCalc(curH, curL, eTpoRows, tpoVA)
            prvPOC := lo_ + st_ * (pI + 0.5)
            prvVAH := lo_ + st_ * (hI + 1)
            prvVAL := lo_ + st_ * lI
            prvEnd := bar_index - 1
            saveHist(c_, lo_, st_, pI, hI, lI, curStart, bar_index - 1, prvPOC, prvVAH, prvVAL)
            saveSingles(c_, lo_, st_)
            nPOC.addN(prvPOC, prvEnd, nPocMax + 1)
        curH.clear()
        curL.clear()
        curStart := bar_index
        blkH := high
        blkL := low
        lastBlk := blkId
    else
        if na(lastBlk) or blkId != lastBlk
            if not na(blkH)
                curH.push(blkH)
                curL.push(blkL)
            blkH := high
            blkL := low
            lastBlk := blkId
        else
            blkH := math.max(blkH, high)
            blkL := math.min(blkL, low)
    nPOC.testN(high, low)

bool canW = timeframe.in_seconds(timeframe.period) < timeframe.in_seconds("W")
bool canM = timeframe.in_seconds(timeframe.period) < timeframe.in_seconds("M")
bool needSide = htfTpo and eTpoPer == "Daily" and eTpoOn
int sideRows = math.min(eTpoRows, 32)
if needSide and canW
    tW.step(newW, blkId, sideRows, tpoVA)
if needSide and canM
    tM.step(newM, blkId, sideRows, tpoVA)

if spTop.size() > 0
    for i = 0 to spTop.size() - 1
        if spX1.get(i) == 0
            float mxv = math.max(spMax.get(i), high)
            float mnv = math.min(spMin.get(i), low)
            spMax.set(i, mxv)
            spMin.set(i, mnv)
            if mxv >= spTop.get(i) and mnv <= spBot.get(i)
                spX1.set(i, bar_index)

// ── 3 · Гол түвшин. Хөндөгдөөгүй нээлт хүрвэл арилна. ──
[dO, dPH, dPL, dPC] = request.security(syminfo.tickerid, "D", [open, high[1], low[1], close[1]], lookahead = barmerge.lookahead_on)
[wO, wPH, wPL, wPC] = request.security(syminfo.tickerid, "W", [open, high[1], low[1], close[1]], lookahead = barmerge.lookahead_on)
[mO, mPH, mPL, mPC] = request.security(syminfo.tickerid, "M", [open, high[1], low[1], close[1]], lookahead = barmerge.lookahead_on)
[qO, qPH, qPL, qPC] = request.security(syminfo.tickerid, "3M", [open, high[1], low[1], close[1]], lookahead = barmerge.lookahead_on)
[yO, yPH, yPL, yPC] = request.security(syminfo.tickerid, "12M", [open, high[1], low[1], close[1]], lookahead = barmerge.lookahead_on)
var KL kD = KL.new()
var KL kW = KL.new()
var KL kM = KL.new()
var KL kQ = KL.new()
var KL kY = KL.new()
var Naked nkD = newNaked()
var Naked nkW = newNaked()
var Naked nkM = newNaked()
var Naked nkQ = newNaked()
var Naked nkY = newNaked()
kD.roll(newD, dO, nkD, klNakMax)
kW.roll(newW, wO, nkW, klNakMax)
kM.roll(newM, mO, nkM, klNakMax)
kQ.roll(newQ, qO, nkQ, klNakMax)
kY.roll(newY, yO, nkY, klNakMax)
bool inAsia = not na(time(timeframe.period, asiaSes, "America/New_York"))
bool inLon = not na(time(timeframe.period, lonSes, "America/New_York"))
bool inNY = not na(time(timeframe.period, nySes, "America/New_York"))
var Sess sA = Sess.new()
var Sess sL = Sess.new()
var Sess sN = Sess.new()
var bool wasAsia = false
var bool wasLon = false
var bool wasNY = false
sA.track(inAsia, wasAsia)
sL.track(inLon, wasLon)
sN.track(inNY, wasNY)
wasAsia := inAsia
wasLon := inLon
wasNY := inNY

// Профайлд хэрэглэх баарын цонх. Сүүлийн 500 баар.
int dayKey = int(nz(time("D")))
int weekKey = int(nz(time("W")))
int monKey = int(nz(time("M")))
int yearKey = int(nz(time("12M")))
int sesId = inNY ? 3 : inLon ? 2 : inAsia ? 1 : 0
if bX.size() > 0 and bX.get(bX.size() - 1) == bar_index
    int li = bX.size() - 1
    bH.set(li, high)
    bL.set(li, low)
    bV.set(li, nz(volume))
    bSes.set(li, sesId)
    bDay.set(li, dayKey)
    bWeek.set(li, weekKey)
    bMon.set(li, monKey)
    bYear.set(li, yearKey)
else
    bH.push(high)
    bL.push(low)
    bV.push(nz(volume))
    bX.push(bar_index)
    bSes.push(sesId)
    bDay.push(dayKey)
    bWeek.push(weekKey)
    bMon.push(monKey)
    bYear.push(yearKey)
    if bH.size() > 500
        bH.shift()
        bL.shift()
        bV.shift()
        bX.shift()
        bSes.shift()
        bDay.shift()
        bWeek.shift()
        bMon.shift()
        bYear.shift()

// ── 4 · Дельта. Relative / Z-score / SMA. Огцом үед лаа будна. ──
bool ltfLower = timeframe.in_seconds(ltfIn) <= timeframe.in_seconds(timeframe.period)
string ltfUse = ltfLower ? ltfIn : timeframe.period
[lO, lC, lH, lL, lV] = request.security_lower_tf(syminfo.tickerid, ltfUse, [open, close, high, low, volume])
float buyV = 0.0
float sellV = 0.0
float maxV = -1.0
float maxP = hlc3
int nLtf = lV.size()
bool useLtf = dMethod == "Intrabar (LTF)" and nLtf > 0
var float prevLtfC = na
if useLtf
    for i = 0 to nLtf - 1
        float v = nz(lV.get(i))
        float o = lO.get(i)
        float c = lC.get(i)
        if c > o
            buyV += v
        else if c < o
            sellV += v
        else if not na(prevLtfC) and c > prevLtfC
            buyV += v
        else if not na(prevLtfC) and c < prevLtfC
            sellV += v
        else
            buyV += v * 0.5
            sellV += v * 0.5
        prevLtfC := c
        if v > maxV
            maxV := v
            maxP := (lH.get(i) + lL.get(i) + c) / 3.0
else
    float rng = high - low
    float vv = nz(volume)
    float frac = rng > 0 ? (close - open) / rng : 0.0
    buyV := vv * (1.0 + frac) / 2.0
    sellV := vv * (1.0 - frac) / 2.0
    maxP := hlc3
    prevLtfC := close
float delta = buyV - sellV
float absD = math.abs(delta)
float relBase = ta.sma(absD, relLen)
float zBase = ta.stdev(delta, zLen)
float smaBase = ta.sma(absD, smaLen)
float thrBase = dThr == "Z-score" ? zBase : dThr == "SMA" ? smaBase : relBase
float mag = thrBase > 0 ? absD / thrBase : 0.0
float k1 = t1 * eZ
float k2 = t2 * eZ
float k3 = t3 * eZ
int tier = t3On and mag >= k3 ? 3 : t2On and mag >= k2 ? 2 : t1On and mag >= k1 ? 1 : 0
bool isBuy = delta > 0
var float cvd = 0.0
if newD
    cvd := 0.0
cvd += delta
color tierCol = tier == 3 ? (isBuy ? t3u : t3d) : tier == 2 ? (isBuy ? t2u : t2d) : tier == 1 ? (isBuy ? t1u : t1d) : na
barcolor(dOn and colorBars and tier > 0 ? tierCol : na, title = "Delta spike bar color")
float bubP = bubLoc == "Max-volume price" ? maxP : (isBuy ? low : high)
bool bubBase = dOn and bubOn and tier >= eBubMin
bool tierPal = bubPal == "Tier colors"
plotshape(bubBase and isBuy and tier == 1 ? bubP : na, "Buy bubble T1", shape.circle, location.absolute, tierPal ? t1u : color.new(bubBuy, 45), size = size.tiny)
plotshape(bubBase and isBuy and tier == 2 ? bubP : na, "Buy bubble T2", shape.circle, location.absolute, tierPal ? t2u : color.new(bubBuy, 20), size = size.small)
plotshape(bubBase and isBuy and tier == 3 ? bubP : na, "Buy bubble T3", shape.circle, location.absolute, tierPal ? t3u : bubBuy, size = size.normal)
plotshape(bubBase and not isBuy and tier == 1 ? bubP : na, "Sell bubble T1", shape.circle, location.absolute, tierPal ? t1d : color.new(bubSell, 45), size = size.tiny)
plotshape(bubBase and not isBuy and tier == 2 ? bubP : na, "Sell bubble T2", shape.circle, location.absolute, tierPal ? t2d : color.new(bubSell, 20), size = size.small)
plotshape(bubBase and not isBuy and tier == 3 ? bubP : na, "Sell bubble T3", shape.circle, location.absolute, tierPal ? t3d : bubSell, size = size.normal)
if bubBase
    if bubX.size() > 0 and bubX.get(bubX.size() - 1) == bar_index
        int bi = bubX.size() - 1
        bubY.set(bi, bubP)
        bubDlt.set(bi, delta)
        bubS.set(bi, isBuy ? 1 : -1)
    else
        bubX.push(bar_index)
        bubY.push(bubP)
        bubDlt.push(delta)
        bubS.push(isBuy ? 1 : -1)
        if bubX.size() > 12
            bubX.shift()
            bubY.shift()
            bubDlt.shift()
            bubS.shift()
else if bubX.size() > 0 and bubX.get(bubX.size() - 1) == bar_index
    bubX.pop()
    bubY.pop()
    bubDlt.pop()
    bubS.pop()

bool isPerp = syminfo.type == "crypto" and str.endswith(syminfo.ticker, ".P")
string oiSym = isPerp ? syminfo.prefix + ":" + syminfo.ticker + "_OI" : syminfo.tickerid
float oiRaw = request.security(oiSym, timeframe.period, close, ignore_invalid_symbol = true)
float oi = isPerp ? oiRaw : na
float oiChg = oi - oi[1]
float oiSd = ta.stdev(oiChg, 50)
float oiZ = oiSd > 0 ? oiChg / oiSd : na
bool oiUp = oiOn and isPerp and not na(oiZ) and oiZ >= oiZThr
bool oiDn = oiOn and isPerp and not na(oiZ) and oiZ <= -oiZThr
plotshape(oiUp, "OI pump", shape.circle, location.abovebar, oiPump, size = size.tiny)
plotshape(oiDn, "OI dump", shape.circle, location.abovebar, oiDump, size = size.tiny)

// ── 5 · Дохио. Зөвхөн баталгаажсан баар. ──
bool vwShort = sigOn and sigVW and barstate.isconfirmed and high >= bU2 and close < bU2 and (not sigDelta or delta < 0)
bool vwLong = sigOn and sigVW and barstate.isconfirmed and low <= bL2 and close > bL2 and (not sigDelta or delta > 0)
bool pocXUp = ta.crossover(close, prvPOC)
bool pocXDn = ta.crossunder(close, prvPOC)
bool pocLong = sigOn and sigPOC and tpoActive and barstate.isconfirmed and pocXUp and (not sigDelta or delta > 0)
bool pocShort = sigOn and sigPOC and tpoActive and barstate.isconfirmed and pocXDn and (not sigDelta or delta < 0)
plotshape(vwLong, "VWAP -2σ rejection long", shape.labelup, location.belowbar, color.new(#4CAF50, 0), text = "VW", textcolor = color.white, size = size.tiny)
plotshape(vwShort, "VWAP +2σ rejection short", shape.labeldown, location.abovebar, color.new(#F23645, 0), text = "VW", textcolor = color.white, size = size.tiny)
plotshape(pocLong, "POC reclaim long", shape.labelup, location.belowbar, color.new(#2962FF, 0), text = "POC", textcolor = color.white, size = size.tiny)
plotshape(pocShort, "POC loss short", shape.labeldown, location.abovebar, color.new(#FF9800, 0), text = "POC", textcolor = color.white, size = size.tiny)
alertcondition(vwLong, "VWAP -2σ rejection (long)", "OS-AIO: VWAP -2σ rejection with buy delta on {{ticker}} at {{close}}")
alertcondition(vwShort, "VWAP +2σ rejection (short)", "OS-AIO: VWAP +2σ rejection with sell delta on {{ticker}} at {{close}}")
alertcondition(pocLong, "TPO POC reclaim (long)", "OS-AIO: close reclaimed previous TPO POC on {{ticker}} at {{close}}")
alertcondition(pocShort, "TPO POC lost (short)", "OS-AIO: close lost previous TPO POC on {{ticker}} at {{close}}")

// ── Зураг. Баруун ирмэгт богино шугам, monospace шошго. ──
addLvl(Lvl[] a, float p, string txt, string pre, string kind, color c, string st, int w, bool dl, int g, int rank, string tip) =>
    if not na(p)
        a.push(Lvl.new(p, txt, pre, kind, c, bar_index + eExt, st, w, dl, g, rank, tip))

vwOne(string pre, string kind) =>
    string body = vwNaming == "Orochi (wVAH)" ? str.lower(pre) + kind : pre + " " + kind
    (vwUnder ? "____" : "") + body

addVW(Lvl[] a, VW s, string pre, string pPre, color c, int rank, bool showThis) =>
    if showThis
        bool curOn = autoAdapt ? true : lblCur
        if curOn
            addLvl(a, s.vw, vwOne(pre, "VWAP"), pre, "VWAP", c, line.style_solid, 1, false, 0, rank, "Одоогийн VWAP. Хэмжээстэй дундаж үнэ.")
            addLvl(a, s.vw + s.sd * m1, vwOne(pre, "VAH"), pre, "VAH", c, line.style_solid, 1, false, 0, rank, "VAH. VWAP дээр нэмэх 1 стандарт хазайлт. Үнийн бүсийн дээд хязгаар.")
            addLvl(a, s.vw - s.sd * m1, vwOne(pre, "VAL"), pre, "VAL", c, line.style_solid, 1, false, 0, rank, "VAL. VWAP хасах 1 стандарт хазайлт. Үнийн бүсийн доод хязгаар.")
            if lblCur2
                addLvl(a, s.vw + s.sd * m2, vwOne(pre, "+2σ"), pre, "+2σ", c, line.style_dotted, 1, false, 0, rank, "+2 стандарт хазайлт.")
                addLvl(a, s.vw - s.sd * m2, vwOne(pre, "-2σ"), pre, "-2σ", c, line.style_dotted, 1, false, 0, rank, "-2 стандарт хазайлт.")
                addLvl(a, s.vw + s.sd * m3, vwOne(pre, "+3σ"), pre, "+3σ", c, line.style_dotted, 1, false, 0, rank, "+3 стандарт хазайлт.")
                addLvl(a, s.vw - s.sd * m3, vwOne(pre, "-3σ"), pre, "-3σ", c, line.style_dotted, 1, false, 0, rank, "-3 стандарт хазайлт.")
        if lblPrev and not na(s.pvw)
            addLvl(a, s.pvw, vwOne(pPre, "VWAP"), pPre, "VWAP", c, line.style_dotted, 1, prevLines, 0, rank, "Өмнөх үеийн VWAP.")
            addLvl(a, s.pvw + s.psd * m1, vwOne(pPre, "VAH"), pPre, "VAH", c, line.style_dotted, 1, prevLines, 0, rank, "Өмнөх үеийн VAH.")
            addLvl(a, s.pvw - s.psd * m1, vwOne(pPre, "VAL"), pPre, "VAL", c, line.style_dotted, 1, prevLines, 0, rank, "Өмнөх үеийн VAL.")

addKL(Lvl[] a, float p, string tag, color c, string st, int rank, string tip) =>
    addLvl(a, p, tag + " " + fmtPrice(p), tag, "", c, st, 1, true, 0, rank, tip)

emitLab(float p, string txt, string tip, color c, int x) =>
    if not na(p) and str.length(txt) > 0 and gLabels.size() < 450
        gLabels.push(label.new(x, p, txt, xloc = xloc.bar_index, yloc = yloc.price, color = labBg, style = label.style_label_left, textcolor = c, size = lblSz, textalign = text.align_left, tooltip = tip, text_font_family = font.family_monospace))
    0

showTxt(int n, bool same, bool key, string prefs, string kind, string keys, string txt, float price) =>
    string s = txt
    if n > 1 and same and kind != ""
        s := prefs + " " + kind
        if vwUnder
            s := "____" + s
    else if n > 1 and key and keys != ""
        s := keys + " " + fmtPrice(price)
    s

drawGroup(Lvl[] a, int g, float tol) =>
    float[] ps = array.new<float>()
    int[] ix = array.new<int>()
    if a.size() > 0
        for i = 0 to a.size() - 1
            if a.get(i).grp == g
                ps.push(a.get(i).price)
                ix.push(i)
    if ps.size() > 0
        int[] ord = ps.sort_indices(order.ascending)
        float curP = na
        string curTxt = ""
        string curPre = ""
        string curKind = ""
        string curKeys = ""
        string curTip = ""
        color curC = na
        int curR = 99
        int curX = bar_index
        int curN = 0
        bool curSame = false
        bool curKey = false
        for k = 0 to ord.size() - 1
            Lvl L = a.get(ix.get(ord.get(k)))
            bool near = not na(curP) and math.abs(L.price - curP) <= tol
            if near and curN > 0
                curN += 1
                curTxt := curTxt + " / " + L.txt
                curTip := curTip + "\n" + L.tip
                if L.kind == "" or L.kind != curKind
                    curSame := false
                else
                    curPre := curPre + " / " + str.upper(L.pre)
                if L.kind != "" or L.pre == ""
                    curKey := false
                else if curKey
                    curKeys := curKeys + " / " + L.pre
                if L.rank < curR
                    curR := L.rank
                    curC := L.col
            else
                if curN > 0
                    emitLab(curP, showTxt(curN, curSame, curKey, curPre, curKind, curKeys, curTxt, curP), curTip, curC, curX)
                curP := L.price
                curTxt := L.txt
                curKind := L.kind
                curSame := L.kind != ""
                curPre := str.upper(L.pre)
                curKey := L.kind == "" and L.pre != ""
                curKeys := curKey ? L.pre : ""
                curTip := L.tip
                curC := L.col
                curR := L.rank
                curX := L.x2
                curN := 1
        if curN > 0
            emitLab(curP, showTxt(curN, curSame, curKey, curPre, curKind, curKeys, curTxt, curP), curTip, curC, curX)
    0

pushBox(int l, float t, int r, float b, color bg) =>
    bool ok = gBoxes.size() < 470 and not na(t) and not na(b) and r > l
    if ok
        gBoxes.push(box.new(l, t, r, b, xloc = xloc.bar_index, border_color = color.new(color.black, 100), bgcolor = bg))
    ok

pushLn(int x1, float y1, int x2, float y2, color c, string st, int w) =>
    if gLines.size() < 470 and not na(y1) and x2 > x1
        gLines.push(line.new(x1, y1, x2, y2, xloc = xloc.bar_index, extend = extend.none, color = c, style = st, width = w))
    0

addVol(float[] bins, float lo, float step, int rows, float hiP, float loP, float volP) =>
    if volP > 0 and step > 0 and not na(hiP) and not na(loP)
        int b0 = int(math.floor((math.min(loP, hiP) - lo) / step))
        int b1 = int(math.floor((math.max(loP, hiP) - lo) / step))
        b0 := math.max(0, math.min(rows - 1, b0))
        b1 := math.max(0, math.min(rows - 1, b1))
        int span = math.max(1, b1 - b0 + 1)
        float each = volP / span
        for b = b0 to b1
            bins.set(b, bins.get(b) + each)
    0

drawSeg(int i0, int i1, int rows, float vaPct, color inC, color outC, string tag, bool fromLeft, bool onAxis, Lvl[] lv) =>
    if i1 >= i0 and i0 >= 0 and rows >= 8 and gBoxes.size() < 450
        float lo = bL.get(i0)
        float hi = bH.get(i0)
        for i = i0 to i1
            lo := math.min(lo, bL.get(i))
            hi := math.max(hi, bH.get(i))
        float step = math.max((hi - lo) / rows, syminfo.mintick)
        float[] bins = array.new<float>(rows, 0.0)
        for i = i0 to i1
            bool live = bX.get(i) == bar_index and useLtf and lV.size() > 0
            if live
                int n = lV.size()
                for j = 0 to n - 1
                    addVol(bins, lo, step, rows, lH.get(j), lL.get(j), nz(lV.get(j)))
            else
                addVol(bins, lo, step, rows, bH.get(i), bL.get(i), bV.get(i))
        float total = bins.sum()
        if total > 0
            float mx = bins.max()
            int pocI = 0
            float best = 1e10
            for b = 0 to rows - 1
                if bins.get(b) == mx
                    float dist = math.abs(b - (rows - 1) / 2.0)
                    if dist < best
                        best := dist
                        pocI := b
            float acc = bins.get(pocI)
            int up = pocI
            int dn = pocI
            while acc < total * vaPct and (up < rows - 1 or dn > 0)
                float nu = up < rows - 1 ? bins.get(up + 1) : -1.0
                float nd = dn > 0 ? bins.get(dn - 1) : -1.0
                if nu >= nd and up < rows - 1
                    up += 1
                    acc += math.max(nu, 0.0)
                else if dn > 0
                    dn -= 1
                    acc += math.max(nd, 0.0)
                else
                    break
            float pocP = lo + step * (pocI + 0.5)
            float vahP = lo + step * (up + 1)
            float valP = lo + step * dn
            int xL = clampX(bX.get(i0))
            int xR = math.max(xL + 1, bX.get(i1))
            int spanX = math.max(1, xR - xL)
            int maxW = math.max(2, math.min(fromLeft ? int(math.round(spanX * 0.42)) : 14, 28))
            pushBox(xL, vahP, xR, valP, color.new(inC, 92))
            if mx > 0
                for b = 0 to rows - 1
                    if gBoxes.size() >= 470
                        break
                    float cv = bins.get(b)
                    if cv > 0
                        int w = math.max(1, int(math.round(cv / mx * maxW)))
                        bool inside = b >= dn and b <= up
                        int left = fromLeft ? xL : xR - w
                        int right = fromLeft ? xL + w : xR
                        pushBox(left, lo + step * (b + 1), math.max(left + 1, right), lo + step * b, color.new(inside ? inC : outC, inside ? 58 : 76))
            pushLn(xL, pocP, xR, pocP, pocCol, line.style_solid, 2)
            pushLn(xL, vahP, xR, vahP, vaLineCol, line.style_dotted, 1)
            pushLn(xL, valP, xR, valP, vaLineCol, line.style_dotted, 1)
            string tp = tag + " хэмжээний профайл. POC нь хамгийн их хэмжээтэй үнэ. TPO-оос тусдаа."
            if onAxis
                addLvl(lv, vahP, tag + " VAH " + fmtPrice(vahP), tag + "·VAH", "", inC, line.style_dotted, 1, false, 0, 2, "VAH · " + tp)
                addLvl(lv, pocP, tag + " POC " + fmtPrice(pocP), tag + "·POC", "", pocCol, line.style_solid, 1, false, 0, 1, "POC · " + tp)
                addLvl(lv, valP, tag + " VAL " + fmtPrice(valP), tag + "·VAL", "", inC, line.style_dotted, 1, false, 0, 2, "VAL · " + tp)
            else if gLabels.size() < 440
                int lx = xR
                gLabels.push(label.new(lx, pocP, tag + " POC", xloc = xloc.bar_index, yloc = yloc.price, color = labBg, style = label.style_label_right, textcolor = pocCol, size = size.tiny, textalign = text.align_right, tooltip = "POC · " + tp + " " + fmtPrice(pocP), text_font_family = font.family_monospace))
    0

collectSegs(int kind, int want) =>
    int[] ss = array.new<int>()
    int[] ee = array.new<int>()
    int[] kk = array.new<int>()
    int i = bH.size() - 1
    int guard = 0
    while i >= 0 and ss.size() < want and guard < 600
        guard += 1
        int key = kind == 1 ? bSes.get(i) : kind == 2 ? bDay.get(i) : kind == 3 ? bWeek.get(i) : kind == 4 ? bMon.get(i) : bYear.get(i)
        if kind == 1 and key == 0
            i -= 1
        else
            int j = i
            int guard2 = 0
            while j > 0 and guard2 < 600
                guard2 += 1
                int prevKey = kind == 1 ? bSes.get(j - 1) : kind == 2 ? bDay.get(j - 1) : kind == 3 ? bWeek.get(j - 1) : kind == 4 ? bMon.get(j - 1) : bYear.get(j - 1)
                if prevKey != key
                    break
                j -= 1
            ss.unshift(j)
            ee.unshift(i)
            kk.unshift(key)
            i := j - 1
    [ss, ee, kk]

drawTpoHist() =>
    if showPrevP and hN.size() > 0
        int nP = hN.size()
        int drawN = math.min(nP, eTpoHist)
        int from = nP - drawN
        for p = from to nP - 1
            if gBoxes.size() >= 460
                break
            int rows = hN.get(p)
            int off = 0
            if p > 0
                for j = 0 to p - 1
                    off += hN.get(j)
            if off + rows <= hBins.size() and rows > 0 and not na(hStep.get(p))
                int x0 = clampX(hX0.get(p))
                int x1e = math.max(x0 + 1, hX1.get(p))
                float mx = 0.0
                for b = 0 to rows - 1
                    mx := math.max(mx, hBins.get(off + b))
                pushBox(x0, hVah.get(p), x1e, hVal.get(p), vaBoxCol)
                int maxW = math.max(1, int(math.round((x1e - x0) * prevWPct / 100.0)))
                if mx > 0
                    for b = 0 to rows - 1
                        if gBoxes.size() >= 470
                            break
                        float cv = hBins.get(off + b)
                        if cv > 0
                            int w = math.max(1, int(math.round(cv / mx * maxW)))
                            bool inside = b >= hValI.get(p) and b <= hVahI.get(p)
                            color hc = inside ? histInCol : histOutCol
                            pushBox(x0, hLo.get(p) + hStep.get(p) * (b + 1), x0 + w, hLo.get(p) + hStep.get(p) * b, hc)
                pushLn(x0, hPoc.get(p), x1e, hPoc.get(p), color.new(pocCol, 25), line.style_solid, pocW)
                if p < nP - 1 and gLabels.size() < 440
                    gLabels.push(label.new(x1e, hPoc.get(p), "POC", xloc = xloc.bar_index, yloc = yloc.price, color = labBg, style = label.style_label_right, textcolor = pocCol, size = size.tiny, textalign = text.align_right, tooltip = "Өмнөх TPO POC. Хамгийн их хугацаа зарцуулсан үнэ. " + fmtPrice(hPoc.get(p)), text_font_family = font.family_monospace))
            if (excessOn or poorOn) and p == nP - 1 and rows > 0 and off + rows <= hBins.size()
                int topI = -1
                int botI = -1
                for b = 0 to rows - 1
                    if hBins.get(off + b) > 0
                        if botI < 0
                            botI := b
                        topI := b
                if topI >= 0 and botI >= 0 and gLabels.size() < 445
                    float topPx = hLo.get(p) + hStep.get(p) * (topI + 0.5)
                    float botPx = hLo.get(p) + hStep.get(p) * (botI + 0.5)
                    bool exH = hBins.get(off + topI) <= 1.0
                    bool exL = hBins.get(off + botI) <= 1.0
                    if excessOn and exH
                        gLabels.push(label.new(bar_index + eExt, topPx, "Excess H", xloc = xloc.bar_index, yloc = yloc.price, color = labBg, style = label.style_label_left, textcolor = #9C27B0, size = size.tiny, tooltip = "Илүүдэл дээд. Орой дээр ганц TPO, хүчтэй түлхэлт.", text_font_family = font.family_monospace))
                    if poorOn and not exH
                        gLabels.push(label.new(bar_index + eExt, topPx, "Poor H", xloc = xloc.bar_index, yloc = yloc.price, color = labBg, style = label.style_label_left, textcolor = ink, size = size.tiny, tooltip = "Сул дээд. Орой дээр олон TPO, дутуу аукцион.", text_font_family = font.family_monospace))
                    if excessOn and exL
                        gLabels.push(label.new(bar_index + eExt, botPx, "Excess L", xloc = xloc.bar_index, yloc = yloc.price, color = labBg, style = label.style_label_left, textcolor = #9C27B0, size = size.tiny, tooltip = "Илүүдэл доод. Ёроолд ганц TPO.", text_font_family = font.family_monospace))
                    if poorOn and not exL
                        gLabels.push(label.new(bar_index + eExt, botPx, "Poor L", xloc = xloc.bar_index, yloc = yloc.price, color = labBg, style = label.style_label_left, textcolor = ink, size = size.tiny, tooltip = "Сул доод. Ёроолд олон TPO, дутуу аукцион.", text_font_family = font.family_monospace))
    0

drawDev() =>
    if showDevP and tpoActive and gBoxes.size() < 450
        float[] hs = curH.copy()
        float[] ls = curL.copy()
        if not na(blkH)
            hs.push(blkH)
            ls.push(blkL)
        if hs.size() > 0
            [dc, dlo, dst, dpI, dhI, dlI] = tpoCalc(hs, ls, eTpoRows, tpoVA)
            if not na(dst) and dc.size() > 0
                float dmx = dc.max()
                int xR = bar_index + eDevOff
                float dPOC = dlo + dst * (dpI + 0.5)
                float dVAH = dlo + dst * (dhI + 1)
                float dVAL = dlo + dst * dlI
                if dmx > 0
                    for b = 0 to dc.size() - 1
                        if gBoxes.size() >= 470
                            break
                        float cv = dc.get(b)
                        if cv > 0
                            int w = math.max(1, int(math.round(cv / dmx * devW)))
                            color hc = b >= dlI and b <= dhI ? histInCol : histOutCol
                            pushBox(xR - w, dlo + dst * (b + 1), xR, dlo + dst * b, hc)
                pushLn(xR - devW, dPOC, xR, dPOC, pocCol, line.style_solid, 2)
                pushLn(xR - devW, dVAH, xR, dVAH, vaLineCol, line.style_solid, 1)
                pushLn(xR - devW, dVAL, xR, dVAL, vaLineCol, line.style_solid, 1)
                if gLabels.size() < 440
                    gLabels.push(label.new(xR, dVAH, tpoCurTag + " VAH (" + fmtPrice(dVAH) + ")", xloc = xloc.bar_index, yloc = yloc.price, color = labBg, style = label.style_label_left, textcolor = vaLineCol, size = lblSz, tooltip = "Хөгжиж буй профайлын VAH. Үнийн бүсийн дээд хязгаар.", text_font_family = font.family_monospace))
                    gLabels.push(label.new(xR, dPOC, tpoCurTag + " POC (" + fmtPrice(dPOC) + ")", xloc = xloc.bar_index, yloc = yloc.price, color = labBg, style = label.style_label_left, textcolor = pocCol, size = lblSz, tooltip = "Хөгжиж буй профайлын POC. Хамгийн их хугацаа зарцуулсан үнэ.", text_font_family = font.family_monospace))
                    gLabels.push(label.new(xR, dVAL, tpoCurTag + " VAL (" + fmtPrice(dVAL) + ")", xloc = xloc.bar_index, yloc = yloc.price, color = labBg, style = label.style_label_left, textcolor = vaLineCol, size = lblSz, tooltip = "Хөгжиж буй профайлын VAL. Үнийн бүсийн доод хязгаар.", text_font_family = font.family_monospace))
    0

drawPrevVa(VW s, color c) =>
    if prevVaBox and not lblOnly and s.pEnd >= s.pStart and s.pEnd >= 0 and not na(s.pvw) and not na(s.psd)
        pushBox(clampX(s.pStart), s.pvw + s.psd * m1, math.max(clampX(s.pStart) + 1, s.pEnd), s.pvw - s.psd * m1, color.new(c, 92))
    0

if barstate.islast
    if gLines.size() > 0
        for ln in gLines
            ln.delete()
    gLines.clear()
    if gLabels.size() > 0
        for lb in gLabels
            lb.delete()
    gLabels.clear()
    if gBoxes.size() > 0
        for bx in gBoxes
            bx.delete()
    gBoxes.clear()

    Lvl[] lv = array.new<Lvl>()
    float tol = mergeOn ? nz(atr14) * mergePct / 100.0 : -1.0
    bool labD = autoAdapt ? eShowD : lblDV
    bool labW = autoAdapt ? eShowW : lblWV
    bool labM = autoAdapt ? eShowM : lblMV
    bool labQ = autoAdapt ? eShowQ : lblQV
    bool labY = autoAdapt ? eShowY : lblYV
    addVW(lv, vD, "D", "pD", eColD, 4, labD)
    addVW(lv, vW, "W", "pW", eColW, 3, labW)
    addVW(lv, vM, "M", "pM", eColM, 2, labM)
    addVW(lv, vQ, "Q", "pQ", eColQ, 1, labQ)
    addVW(lv, vY, "Y", "pY", eColY, 0, labY)

    if klOn
        if eYOpen
            addKL(lv, kY.op, "YO", eYCol, line.style_solid, 0, "YO · Энэ жилийн нээлтийн үнэ.")
        if eYHL
            addKL(lv, yPH, "PYH", eYCol, line.style_solid, 0, "PYH · Өмнөх жилийн дээд цэг.")
            addKL(lv, yPL, "PYL", eYCol, line.style_solid, 0, "PYL · Өмнөх жилийн доод цэг.")
        if eYMid and not na(yPH) and not na(yPL)
            addKL(lv, (yPH + yPL) / 2.0, "PYM", eYCol, line.style_dotted, 0, "PYM · Өмнөх жилийн дундаж. Тасархай шугам.")
        if eYCls
            addKL(lv, yPC, "PYC", eYCol, line.style_dotted, 0, "PYC · Өмнөх жилийн хаалт.")
        if eYCur
            addKL(lv, kY.cH, "YH", eYCol, line.style_solid, 0, "YH · Энэ жилийн дээд цэг.")
            addKL(lv, kY.cL, "YL", eYCol, line.style_solid, 0, "YL · Энэ жилийн доод цэг.")
        if eQOpen
            addKL(lv, kQ.op, "QO", qCol, line.style_solid, 1, "QO · Энэ улирлын нээлт.")
        if eQHL
            addKL(lv, qPH, "PQH", qCol, line.style_solid, 1, "PQH · Өмнөх улирлын дээд цэг.")
            addKL(lv, qPL, "PQL", qCol, line.style_solid, 1, "PQL · Өмнөх улирлын доод цэг.")
        if eQMid and not na(qPH) and not na(qPL)
            addKL(lv, (qPH + qPL) / 2.0, "PQM", qCol, line.style_dotted, 1, "PQM · Өмнөх улирлын дундаж.")
        if eQCls
            addKL(lv, qPC, "PQC", qCol, line.style_dashed, 1, "PQC · Өмнөх улирлын хаалт.")
        if eQCur
            addKL(lv, kQ.cH, "QH", qCol, line.style_solid, 1, "QH · Энэ улирлын дээд цэг.")
            addKL(lv, kQ.cL, "QL", qCol, line.style_solid, 1, "QL · Энэ улирлын доод цэг.")
        if eMOpen
            addKL(lv, kM.op, "MO", mCol, line.style_solid, 2, "MO · Энэ сарын нээлт.")
        if eMHL
            addKL(lv, mPH, "PMH", mCol, line.style_solid, 2, "PMH · Өмнөх сарын дээд цэг.")
            addKL(lv, mPL, "PML", mCol, line.style_solid, 2, "PML · Өмнөх сарын доод цэг.")
        if eMMid and not na(mPH) and not na(mPL)
            addKL(lv, (mPH + mPL) / 2.0, "PMM", mCol, line.style_dotted, 2, "PMM · Өмнөх сарын дундаж. Тасархай шугам.")
        if eMCls
            addKL(lv, mPC, "PMC", mCol, line.style_dashed, 2, "PMC · Өмнөх сарын хаалт.")
        if eMCur
            addKL(lv, kM.cH, "MH", mCol, line.style_solid, 2, "MH · Энэ сарын дээд цэг.")
            addKL(lv, kM.cL, "ML", mCol, line.style_solid, 2, "ML · Энэ сарын доод цэг.")
        if eWOpen
            addKL(lv, kW.op, "WO", wCol, line.style_solid, 3, "WO · Энэ долоо хоногийн нээлт.")
        if eWHL
            addKL(lv, wPH, "PWH", wCol, line.style_solid, 3, "PWH · Өмнөх долоо хоногийн дээд цэг.")
            addKL(lv, wPL, "PWL", wCol, line.style_solid, 3, "PWL · Өмнөх долоо хоногийн доод цэг.")
        if eWMid and not na(wPH) and not na(wPL)
            addKL(lv, (wPH + wPL) / 2.0, "PWM", wCol, line.style_dotted, 3, "PWM · Өмнөх долоо хоногийн дундаж. Тасархай шугам.")
        if eWCls
            addKL(lv, wPC, "PWC", wCol, line.style_dashed, 3, "PWC · Өмнөх долоо хоногийн хаалт.")
        if eWCur
            addKL(lv, kW.cH, "WH", wCol, line.style_solid, 3, "WH · Энэ долоо хоногийн дээд цэг.")
            addKL(lv, kW.cL, "WL", wCol, line.style_solid, 3, "WL · Энэ долоо хоногийн доод цэг.")
        if eDOpen
            addKL(lv, kD.op, "DO", dCol, line.style_solid, 4, "DO · Өнөөдрийн нээлтийн үнэ.")
        if eDHL
            addKL(lv, dPH, "PDH", dCol, line.style_solid, 4, "PDH · Өмнөх өдрийн дээд цэг.")
            addKL(lv, dPL, "PDL", dCol, line.style_solid, 4, "PDL · Өмнөх өдрийн доод цэг.")
        if eDMid and not na(dPH) and not na(dPL)
            addKL(lv, (dPH + dPL) / 2.0, "PDM", dCol, line.style_dotted, 4, "PDM · Өмнөх өдрийн дундаж. Тасархай шугам.")
        if eDCls
            addKL(lv, dPC, "PDC", dCol, line.style_dotted, 4, "PDC · Өмнөх өдрийн хаалт.")
        if eDCur
            addKL(lv, kD.cH, "DH", dCol, line.style_solid, 4, "DH · Өнөөдрийн дээд цэг.")
            addKL(lv, kD.cL, "DL", dCol, line.style_solid, 4, "DL · Өнөөдрийн доод цэг.")
        if eYNak and nkY.p.size() > 0
            for i = 0 to nkY.p.size() - 1
                addKL(lv, nkY.p.get(i), "nYO", eYCol, line.style_dotted, 0, "nYO · Хөндөгдөөгүй жилийн нээлт. Үнэ дахин хүрвэл арилна.")
        if eQNak and nkQ.p.size() > 0
            for i = 0 to nkQ.p.size() - 1
                addKL(lv, nkQ.p.get(i), "nQO", qCol, line.style_dotted, 1, "nQO · Хөндөгдөөгүй улирлын нээлт.")
        if eMNak and nkM.p.size() > 0
            for i = 0 to nkM.p.size() - 1
                addKL(lv, nkM.p.get(i), "nMO", mCol, line.style_dotted, 2, "nMO · Хөндөгдөөгүй сарын нээлт.")
        if eWNak and nkW.p.size() > 0
            for i = 0 to nkW.p.size() - 1
                addKL(lv, nkW.p.get(i), "nWO", wCol, line.style_dotted, 3, "nWO · Хөндөгдөөгүй долоо хоногийн нээлт.")
        if eDNak and nkD.p.size() > 0
            for i = 0 to nkD.p.size() - 1
                addKL(lv, nkD.p.get(i), "nDO", dCol, line.style_dotted, 4, "nDO · Хөндөгдөөгүй өдрийн нээлт. Үнэ хүрвэл арилна.")
        if eAsia and not na(sA.h)
            addKL(lv, sA.h, "AS H", asiaCol, line.style_dashed, 5, "AS H · Азийн сешний дээд цэг.")
            addKL(lv, sA.l, "AS L", asiaCol, line.style_dashed, 5, "AS L · Азийн сешний доод цэг.")
        if eLon and not na(sL.h)
            addKL(lv, sL.h, "LN H", lonCol, line.style_dashed, 5, "LN H · Лондонгийн сешний дээд цэг.")
            addKL(lv, sL.l, "LN L", lonCol, line.style_dashed, 5, "LN L · Лондонгийн сешний доод цэг.")
        if eNy and not na(sN.h)
            addKL(lv, sN.h, "NY H", nyCol, line.style_dashed, 5, "NY H · Нью-Йоркийн сешний дээд цэг.")
            addKL(lv, sN.l, "NY L", nyCol, line.style_dashed, 5, "NY L · Нью-Йоркийн сешний доод цэг.")

    if tpoActive and not na(prvPOC)
        string pTip = "Өмнөх TPO. POC нь хамгийн их хугацаа зарцуулсан үнэ."
        addLvl(lv, prvVAH, tpoPrevTag + " VAH (" + fmtPrice(prvVAH) + ")", tpoPrevTag, "VAH", vaLineCol, line.style_dotted, 1, extLines, 0, 1, tpoPrevTag + " VAH · Үнийн бүсийн дээд хязгаар. " + pTip)
        addLvl(lv, prvPOC, tpoPrevTag + " POC (" + fmtPrice(prvPOC) + ")", tpoPrevTag, "POC", pocCol, line.style_solid, pocW, extLines, 0, 0, tpoPrevTag + " POC · " + pTip)
        addLvl(lv, prvVAL, tpoPrevTag + " VAL (" + fmtPrice(prvVAL) + ")", tpoPrevTag, "VAL", vaLineCol, line.style_dotted, 1, extLines, 0, 1, tpoPrevTag + " VAL · Үнийн бүсийн доод хязгаар. " + pTip)
    if tpoActive and nPocOn and nPOC.p.size() > 0
        for i = 0 to nPOC.p.size() - 1
            float np = nPOC.p.get(i)
            if np != prvPOC
                addLvl(lv, np, "nPOC (" + fmtPrice(np) + ")", "n", "POC", pocCol, line.style_dotted, 1, true, 0, 0, "nPOC · Хөндөгдөөгүй POC. Үнэ дахин хүрээгүй хяналтын цэг.")
    if needSide and tW.ready
        addLvl(lv, tW.vah, "PW VAH (" + fmtPrice(tW.vah) + ")", "PW", "VAH", vaLineCol, line.style_dotted, 1, true, 0, 3, "PW VAH · Өмнөх долоо хоногийн TPO үнийн бүсийн дээд.")
        addLvl(lv, tW.poc, "PW POC (" + fmtPrice(tW.poc) + ")", "PW", "POC", pocCol, line.style_dotted, 1, true, 0, 3, "PW POC · Өмнөх долоо хоногийн TPO хяналтын цэг.")
        addLvl(lv, tW.val, "PW VAL (" + fmtPrice(tW.val) + ")", "PW", "VAL", vaLineCol, line.style_dotted, 1, true, 0, 3, "PW VAL · Өмнөх долоо хоногийн TPO үнийн бүсийн доод.")
    if needSide and tM.ready
        addLvl(lv, tM.vah, "PM VAH (" + fmtPrice(tM.vah) + ")", "PM", "VAH", vaLineCol, line.style_dotted, 1, true, 0, 2, "PM VAH · Өмнөх сарын TPO үнийн бүсийн дээд.")
        addLvl(lv, tM.poc, "PM POC (" + fmtPrice(tM.poc) + ")", "PM", "POC", pocCol, line.style_dotted, 1, true, 0, 2, "PM POC · Өмнөх сарын TPO хяналтын цэг.")
        addLvl(lv, tM.val, "PM VAL (" + fmtPrice(tM.val) + ")", "PM", "VAL", vaLineCol, line.style_dotted, 1, true, 0, 2, "PM VAL · Өмнөх сарын TPO үнийн бүсийн доод.")

    if eR7 and not na(r7)
        emitLab(r7, "7D " + fmtPrice(r7), "7 хоногийн гүйдэг VWAP. Хаагдсан өдрийн баараар тооцно.", eRoll, bar_index + 2)
    if eR30 and not na(r30)
        emitLab(r30, "30D " + fmtPrice(r30), "30 хоногийн гүйдэг VWAP.", eRoll, bar_index + 2)
    if eR90 and not na(r90)
        emitLab(r90, "90D " + fmtPrice(r90), "90 хоногийн гүйдэг VWAP.", eRoll, bar_index + 2)
    if eR365 and not na(r365)
        emitLab(r365, "365D " + fmtPrice(r365), "365 хоногийн гүйдэг VWAP.", eRoll, bar_index + 2)

    drawPrevVa(vD, eColD)
    drawPrevVa(vW, eColW)
    drawPrevVa(vM, eColM)
    drawPrevVa(vQ, eColQ)
    drawPrevVa(vY, eColY)
    if tpoActive
        drawTpoHist()
        drawDev()
        if singlesOn and spTop.size() > 0
            for i = 0 to spTop.size() - 1
                if gBoxes.size() >= 470
                    break
                int xA0 = clampX(spX0.get(i))
                int xA1 = spX1.get(i) == 0 ? bar_index : spX1.get(i)
                int xR = singleExt or spX1.get(i) != 0 ? math.max(xA0 + 1, xA1) : xA0 + 1
                pushBox(xA0, spTop.get(i), xR, spBot.get(i), color.new(singleCol, spX1.get(i) == 0 ? 62 : 80))

    if eVpOn and bH.size() > 1
        if vpSel == "Session+Day"
            [ss, ee, kk] = collectSegs(1, eVpPast + 1)
            if ss.size() > 0
                for i = 0 to ss.size() - 1
                    string nm = kk.get(i) == 1 ? "AS" : kk.get(i) == 2 ? "LN" : "NY"
                    drawSeg(ss.get(i), ee.get(i), eVpRows, eVpVa, eVpIn, eVpOut, nm, true, false, lv)
            [ds, de, dk] = collectSegs(2, 1)
            if ds.size() > 0
                drawSeg(ds.get(0), de.get(0), eVpRows, eVpVa, eVpIn, eVpOut, "D", false, true, lv)
        else
            int kind = vpSel == "Weekly" ? 3 : vpSel == "Monthly" ? 4 : vpSel == "Yearly" ? 5 : vpSel == "Session+Day" ? 1 : 2
            string tag = kind == 3 ? "W" : kind == 4 ? "M" : kind == 5 ? "Y" : "D"
            [ss2, ee2, kk2] = collectSegs(kind, eVpPast + 1)
            if ss2.size() > 0
                for i = 0 to ss2.size() - 1
                    drawSeg(ss2.get(i), ee2.get(i), eVpRows, eVpVa, eVpIn, eVpOut, tag, true, i == ss2.size() - 1, lv)

    if lv.size() > 0
        for i = 0 to lv.size() - 1
            Lvl L = lv.get(i)
            if L.drawLine
                color lc = L.lstyle == line.style_solid ? color.new(L.col, light ? 0 : 8) : color.new(L.col, light ? 20 : 38)
                pushLn(bar_index, L.price, bar_index + eExt, L.price, lc, L.lstyle, L.lwidth)
    drawGroup(lv, 0, tol)

    if bubX.size() > 0
        int b0 = math.max(0, bubX.size() - 8)
        for i = b0 to bubX.size() - 1
            if gLabels.size() < 450
                bool upB = bubS.get(i) > 0
                string bt = (bubDlt.get(i) > 0 ? "+" : "") + fmtVol(bubDlt.get(i))
                gLabels.push(label.new(bubX.get(i), bubY.get(i), bt, xloc = xloc.bar_index, yloc = yloc.price, color = color.new(color.black, 100), style = label.style_none, textcolor = upB ? bubBuy : bubSell, size = size.tiny, tooltip = "Дельта бөмбөлөг. Авсан хасах зассан тик хэмжээ.", text_font_family = font.family_monospace))

// ── Хүснэгт. Толгой хос хэлээр. ──
tblPosOf(string s) =>
    switch s
        "Bottom Right" => position.bottom_right
        "Top Left" => position.top_left
        "Bottom Left" => position.bottom_left
        => position.top_right
var table dTbl = table.new(tblPosOf(tblPos), 2, 7, bgcolor = tabBg, border_color = tabBd, border_width = 1, frame_color = tabBd, frame_width = 1)
if barstate.islast and tblOn and dOn
    color dc = delta >= 0 ? bubBuy : bubSell
    color cc = cvd >= 0 ? bubBuy : bubSell
    string tfNm = tfKey == "MN" ? "Сар" : tfKey == "D" ? "Өдөр" : tfKey == "4H" ? "4ц" : tfKey == "1H" ? "1ц" : "5м"
    table.cell(dTbl, 0, 0, "Delta · Дельта", text_color = ink, text_size = size.small, text_halign = text.align_left, bgcolor = tabHd, text_font_family = font.family_monospace, tooltip = "Дельта ба тик хэмжээний хураангуй.")
    table.cell(dTbl, 1, 0, dThr + " · " + tfNm, text_color = ink, text_size = size.small, bgcolor = tabHd, text_font_family = font.family_monospace, tooltip = "Босгоны горим ба идэвхтэй цагийн пресет.")
    table.cell(dTbl, 0, 1, "Эх · Source", text_color = ink, text_size = size.small, text_halign = text.align_left, text_font_family = font.family_monospace, tooltip = "XAUUSD-ийн volume нь тик хэмжээ, үнийн өөрчлөлтийн тоо.")
    table.cell(dTbl, 1, 1, useLtf ? "Тик LTF " + ltfUse : "Тик · Candle", text_color = ink, text_size = size.small, text_font_family = font.family_monospace, tooltip = "Тик хэмжээ. Биржийн бодит гэрээний хэмжээ биш.")
    table.cell(dTbl, 0, 2, "Баар Δ · Bar", text_color = ink, text_size = size.small, text_halign = text.align_left, text_font_family = font.family_monospace, tooltip = "Энэ баарын дельта болон босгоноос хэд дахин их болох.")
    table.cell(dTbl, 1, 2, fmtVol(delta) + "  " + str.tostring(mag, "#.0") + "x", text_color = dc, text_size = size.small, text_font_family = font.family_monospace)
    table.cell(dTbl, 0, 3, "CVD · Өдөр", text_color = ink, text_size = size.small, text_halign = text.align_left, text_font_family = font.family_monospace, tooltip = "Өнөөдрийн хуримтлагдсан дельта.")
    table.cell(dTbl, 1, 3, fmtVol(cvd), text_color = cc, text_size = size.small, text_font_family = font.family_monospace)
    table.cell(dTbl, 0, 4, "Ав / Зар", text_color = ink, text_size = size.small, text_halign = text.align_left, text_font_family = font.family_monospace, tooltip = "Авсан ба зассан тик хэмжээ.")
    table.cell(dTbl, 1, 4, fmtVol(buyV) + " / " + fmtVol(sellV), text_color = ink, text_size = size.small, text_font_family = font.family_monospace)
    table.cell(dTbl, 0, 5, "OI · Сонирхол", text_color = ink, text_size = size.small, text_halign = text.align_left, text_font_family = font.family_monospace, tooltip = "Нээлттэй сонирхол. XAUUSD дээр байхгүй. Дэлгэрэнгүй OS-Delta цонхонд.")
    table.cell(dTbl, 1, 5, isPerp and not na(oi) ? fmtVol(oi) : "n/a", text_color = ink, text_size = size.small, text_font_family = font.family_monospace)
    table.cell(dTbl, 0, 6, "Профайл · VP", text_color = ink, text_size = size.small, text_halign = text.align_left, text_font_family = font.family_monospace, tooltip = "Энэ цаг дээр зурж буй хэмжээний профайл.")
    table.cell(dTbl, 1, 6, eVpOn ? vpSel : "Off", text_color = ink, text_size = size.small, text_font_family = font.family_monospace, tooltip = "5м = сешн + өдөр. 1ц = өдөр. 4ц = долоо хоног. Өдөр = сар. Сар = жил.")
