// ── Цагийн ангилал. 1м–30м → 5м, 1ц–3ц → 1ц, 4ц–12ц → 4ц, өдөр/долоо хоног → өдөр, сар → сар. ──
string perNow = timeframe.period
bool isMnTf = str.endswith(perNow, "M")
bool isDayTf = str.endswith(perNow, "D") or str.endswith(perNow, "W") or timeframe.isdaily or timeframe.isweekly
int tfSec = timeframe.in_seconds()
string tfKey = isMnTf ? "MN" : isDayTf ? "D" : tfSec >= 14400 ? "4H" : tfSec >= 3600 ? "1H" : "5m"
bool light = themeIn == "Light"

pickS(string k, string v5, string v1, string v4, string vD, string vM) =>
    k == "1H" ? v1 : k == "4H" ? v4 : k == "D" ? vD : k == "MN" ? vM : v5
pickI(string k, int v5, int v1, int v4, int vD, int vM) =>
    k == "1H" ? v1 : k == "4H" ? v4 : k == "D" ? vD : k == "MN" ? vM : v5
pickF(string k, float v5, float v1, float v4, float vD, float vM) =>
    k == "1H" ? v1 : k == "4H" ? v4 : k == "D" ? vD : k == "MN" ? vM : v5
pickB(string k, bool v5, bool v1, bool v4, bool vD, bool vM) =>
    k == "1H" ? v1 : k == "4H" ? v4 : k == "D" ? vD : k == "MN" ? vM : v5
pickC(string k, color v5, color v1, color v4, color vD, color vM) =>
    k == "1H" ? v1 : k == "4H" ? v4 : k == "D" ? vD : k == "MN" ? vM : v5

