//@version=6
// ═══════════════════════════════════════════════════════════════════════════
//  Orochi-Style All-In-One  ·  VWAP · TPO · Volume Profile · Key Levels · Delta
//  XAUUSD-д зориулсан эх код. Orochi Trading-тай холбоогүй.
//  Цаг бүрт өөр пресет. Шугамыг баруун ирмэгт богино зурна.
//  XAUUSD volume = тик хэмжээ (үнийн өөрчлөлтийн тоо).
//  Зургийг сүүлийн баар дээр устгаад дахин зурна (500 лимит).
// ═══════════════════════════════════════════════════════════════════════════
indicator("Orochi-Style All-In-One (VWAP · TPO · Key Levels · Delta)", shorttitle = "OS-AIO", overlay = true, max_lines_count = 500, max_boxes_count = 500, max_labels_count = 500, max_bars_back = 5000)

// ───────────────────────── 00 · Ерөнхий ─────────────────────────
G0 = "00 · General · Ерөнхий"
themeIn = input.string("Dark", "Theme", options = ["Dark", "Light"], group = G0, tooltip = "Бараан эсвэл цайвар загвар. Шошгоны дэвсгэр, хүснэгт, цагаан өнгийг үүнд тааруулна. Түвшний үндсэн өнгө хэвээр.")
lblSizeIn = input.string("Medium", "Label size", options = ["Tiny", "Small", "Medium", "Normal", "Large"], group = G0, tooltip = "Шошгын хэмжээ. Medium нь ердийн хэмжээ. Автомат горимд цагийн бүлэг үүнийг дарж болно.")
autoAdapt = input.bool(true, "Auto-adapt to timeframe", group = G0, tooltip = "Асаалттай бол чартын цагт тааруулж 5м, 1ц, 4ц, өдөр, сарын пресетийг сонгоно. Доорх цагийн бүлгээр тус бүрийг нь өөрчилнө. Унтраавал ерөнхий тохиргоо үйлчилнэ.")
mergeOn = input.bool(true, "Merge overlapping labels ( A / B )", group = G0, tooltip = "Ойрхон үнэн дээрх шошгыг A / B гэж нэгтгэнэ. Ижил төрөл давхцвал M / Q VAH гэж харуулна.")
mergePct = input.float(8.0, "Merge distance (% of ATR 14)", minval = 0.0, step = 1.0, group = G0, tooltip = "Нэгтгэх зай. ATR-ын хувиар. Их байх тусам хол шошго ч нийлнэ.")
lblOnly = input.bool(false, "Labels only · Зөвхөн шошго", group = G0, tooltip = "VWAP шугам, зурвас, өмнөх үнийн бүсийн хайрцгийг нууж зөвхөн шошгыг үлдээнэ.")

// ───────────────────────── 01 · VWAP ─────────────────────────
G1 = "01 · VWAP · Хэмжээстэй дундаж үнэ"
vwSrc = input.source(hlc3, "Source · Эх үнэ", group = G1, tooltip = "VWAP-д орох үнэ. Анхдагч нь hlc3, өндөр нам хаалтын дундаж.")
vwLblOff = input.int(12, "Label offset (bars) · Шошгын зай", minval = 0, maxval = 80, group = G1, tooltip = "Автомат горим унтарсан үед шошго баруун тийш хэдэн баар суух вэ. Шугамын урт богино.")
vwNaming = input.string("Orochi (wVAH)", "Label naming · Шошгын нэр", options = ["Orochi (wVAH)", "Sigma (W +1σ)"], group = G1, tooltip = "Orochi нэршил wVAH, pwVWAP. Sigma нэршил W +1σ.")
vwUnder = input.bool(false, "Underline tag · Доогуур зураас", group = G1, tooltip = "Шошгын өмнө ____ гэж зураас нэмнэ. Цэвэр харагдахын тулд анхдагчаар унтарсан.")
G1a = "01a · Session VWAPs · Үеийн VWAP (D/W/M/Q/Y)"
showDV = input.bool(true, "Daily · Өдөр", inline = "vd", group = G1a, tooltip = "Өнөөдрийн эхнээс тооцсон өдрийн VWAP.")
colDV = input.color(#D1D4DC, "", inline = "vd", group = G1a, tooltip = "Өдрийн VWAP-ын өнгө.")
dStyle = input.string("Circles", "Style · Загвар", options = ["Circles", "Line"], group = G1a, tooltip = "Өдрийн VWAP-ыг цэгээр (тасархай мэт) эсвэл шугамаар зурах.")
showWV = input.bool(false, "Weekly · Долоо хоног", inline = "vw", group = G1a, tooltip = "Энэ долоо хоногоос тооцсон VWAP. Автомат горимд 5м ба 1ц дээр асна.")
colWV = input.color(#4CAF50, "", inline = "vw", group = G1a, tooltip = "Долоо хоногийн VWAP-ын өнгө.")
showMV = input.bool(false, "Monthly · Сар", inline = "vm", group = G1a, tooltip = "Энэ сараас тооцсон VWAP.")
colMV = input.color(#FF9800, "", inline = "vm", group = G1a, tooltip = "Сарын VWAP-ын өнгө.")
showQV = input.bool(false, "Quarterly · Улирал", inline = "vq", group = G1a, tooltip = "Энэ улирлаас тооцсон VWAP.")
colQV = input.color(#FFC107, "", inline = "vq", group = G1a, tooltip = "Улирлын VWAP-ын өнгө.")
showYV = input.bool(false, "Yearly · Жил", inline = "vy", group = G1a, tooltip = "Энэ жилээс тооцсон VWAP.")
colYV = input.color(#F23645, "", inline = "vy", group = G1a, tooltip = "Жилийн VWAP-ын өнгө.")
G1b = "01b · SD Bands · Хазайлтын зурвас"
bandsOn = input.bool(true, "Show SD bands · Зурвас харуулах", group = G1b, tooltip = "Сонгосон үеийн VWAP дээр стандарт хазайлтын зурвас зурна. Дундаж нь VWAP.")
bandAnchor = input.string("Daily", "Anchored to period · Үе", options = ["Daily", "Weekly", "Monthly", "Quarterly", "Yearly"], group = G1b, tooltip = "Зурвас аль үеийн VWAP дээр тооно. Автомат горимд идэвхтэй VWAP-д таарна.")
b1On = input.bool(true, "±1σ · VAH/VAL", group = G1b, tooltip = "±1 сигма нь VAH ба VAL зурвас. Анхдагчаар асаалттай, дүүргэлттэй.")
m1 = input.float(1.0, "±1 multiplier · Үржүүлэгч", step = 0.1, group = G1b, tooltip = "1 сигмагийн үржүүлэгч. 1.0 нь яг нэг стандарт хазайлт.")
f1On = input.bool(true, "±1 fill · Дүүргэлт", group = G1b, tooltip = "VAH ба VAL хоорондын талбайг бүдэг дүүргэнэ.")
b2On = input.bool(true, "±2σ", group = G1b, tooltip = "±2 сигма. Анхдагчаар асаалттай, дүүргэлтгүй.")
m2 = input.float(2.0, "±2 multiplier · Үржүүлэгч", step = 0.1, group = G1b, tooltip = "2 сигмагийн үржүүлэгч.")
f2On = input.bool(false, "±2 fill · Дүүргэлт", group = G1b, tooltip = "±2 зурвасын дүүргэлт. Анхдагчаар унтарсан.")
b3On = input.bool(false, "±3σ", group = G1b, tooltip = "±3 сигма. Анхдагчаар унтарсан.")
m3 = input.float(3.0, "±3 multiplier · Үржүүлэгч", step = 0.1, group = G1b, tooltip = "3 сигмагийн үржүүлэгч.")
f3On = input.bool(false, "±3 fill · Дүүргэлт", group = G1b, tooltip = "±3 зурвасын дүүргэлт.")
bandLineCol = input.color(color.new(#B2B5BE, 45), "Band line · Зурвасын шугам", group = G1b, tooltip = "Хазайлтын шугамын өнгө. ±2 ба ±3 нь цэгэн загвартай.")
bandFillCol = input.color(color.new(#FFFFFF, 92), "Band fill · Дүүргэлт", group = G1b, tooltip = "±1 үнийн бүсийн дүүргэлтийн өнгө.")
prevVaBox = input.bool(true, "Previous VA box · Өмнөх үнийн бүс", group = G1b, tooltip = "Өмнөх үеийн VWAP ±1σ хооронд бүдэг хайрцаг зурна.")
G1c = "01c · Labels · Шошго"
lblDV = input.bool(false, "Daily labels · Өдрийн шошго", group = G1c, tooltip = "Өдрийн VWAP шошго. Автомат горимд харагдаж буй VWAP-д шошго автоматаар гарна.")
lblWV = input.bool(true, "Weekly · Долоо хоног", group = G1c, tooltip = "Долоо хоногийн VWAP шошго. wVAH, wVWAP, wVAL.")
lblMV = input.bool(true, "Monthly · Сар", group = G1c, tooltip = "Сарын VWAP шошго.")
lblQV = input.bool(true, "Quarterly · Улирал", group = G1c, tooltip = "Улирлын VWAP шошго.")
lblYV = input.bool(false, "Yearly · Жил", group = G1c, tooltip = "Жилийн VWAP шошго.")
lblCur = input.bool(true, "Current labels · Одоогийн шошго", group = G1c, tooltip = "Одоогийн VWAP, VAH, VAL шошго.")
lblCur2 = input.bool(false, "Also ±2σ / ±3σ · Нэмэлт шошго", group = G1c, tooltip = "±2 ба ±3 шошгыг нэмж харуулна.")
lblPrev = input.bool(true, "Previous labels · Өмнөх үе", group = G1c, tooltip = "Өмнөх үеийн pwVWAP, pwVAH, pwVAL шошго.")
prevLines = input.bool(false, "Previous VWAP lines · Өмнөх шугам", group = G1c, tooltip = "Өмнөх VWAP ба ±1σ-г баруун ирмэгт богино шугамаар зурна.")
G1d = "01d · Rolling VWAP · Гүйдэг VWAP"
r7On = input.bool(true, "7D", group = G1d, tooltip = "Сүүлийн 7 өдрийн гүйдэг VWAP. Өдрийн хаагдсан баараар, дахин будахгүй.")
r30On = input.bool(false, "30D", group = G1d, tooltip = "Сүүлийн 30 өдрийн гүйдэг VWAP.")
r90On = input.bool(false, "90D", group = G1d, tooltip = "Сүүлийн 90 өдрийн гүйдэг VWAP.")
r365On = input.bool(false, "365D", group = G1d, tooltip = "Сүүлийн 365 өдрийн гүйдэг VWAP.")
rCol = input.color(color.new(#D1D4DC, 10), "Rolling color · Өнгө", group = G1d, tooltip = "Гүйдэг VWAP-ын өнгө.")

// ───────────────────────── 02 · TPO ─────────────────────────
G2 = "02 · TPO · Цагийн профайл"
tpoOn = input.bool(true, "Enable TPO · TPO асаах", group = G2, tooltip = "Цагийн үнийн профайл. Үнийг хэмжээгээр биш, хэдэн блок хугацаанд хүрч байснаар зурна.")
tpoTFin = input.string("Daily", "Profile period · Профайлын үе", options = ["Daily", "Weekly", "Monthly"], group = G2, tooltip = "Нэг профайл хэр хугацааг хамарна. Чарт энэ үеэс доош байх ёстой.")
tpoMin = input.int(30, "TPO period (minutes) · Блок минут", minval = 1, maxval = 240, group = G2, tooltip = "Нэг TPO блок хэдэн минут вэ. Анхдагч 30 минут.")
tpoRows = input.int(48, "Price rows · Үнийн мөр", minval = 8, maxval = 80, group = G2, tooltip = "Профайлын үнийн мөр. Их байх тусам нарийвчилна, хайрцагны лимитэд ойртоно.")
tpoVA = input.float(68.0, "Value area % · Үнийн бүс %", minval = 10, maxval = 99, group = G2, tooltip = "Үнийн бүсэд багтах TPO-ийн хувь. Анхдагч 68.") / 100.0
tpoHist = input.int(3, "Historical profiles · Өмнөх профайл", minval = 1, maxval = 6, group = G2, tooltip = "Хэдэн хаагдсан TPO профайл зурах вэ. Баруун талд одоо хөгжиж буй профайл нэмэгдэнэ.")
showPrevP = input.bool(true, "Show previous profiles · Өмнөх профайл", group = G2, tooltip = "Хаагдсан профайлуудын гистограмыг зурна.")
prevWPct = input.int(40, "Profile width % · Өргөн %", minval = 5, maxval = 100, group = G2, tooltip = "Гистограм тухайн үеийн өргөний хэдэн хувийг эзлэх вэ.")
showDevP = input.bool(true, "Developing profile · Хөгжиж буй", group = G2, tooltip = "Одоогийн үеийн профайлыг баруун ирмэгт зурна.")
devOff = input.int(16, "Developing offset · Баруун зай", minval = 4, maxval = 80, group = G2, tooltip = "Хөгжиж буй профайл сүүлийн баараас хэдэн баар баруун тийш байх вэ.")
devW = input.int(18, "Developing width · Өргөн", minval = 4, maxval = 80, group = G2, tooltip = "Хөгжиж буй профайлын хамгийн өргөн, баараар.")
tpoLblOff = input.int(12, "Label offset · Шошгын зай", minval = 0, maxval = 80, group = G2, tooltip = "TPO шошго баруун тийш хэдэн баар байх вэ.")
histInCol = input.color(color.new(#B2B5BE, 55), "Histogram in VA · Бүсийн дотор", group = G2, tooltip = "Үнийн бүсийн доторх TPO мөрийн өнгө.")
histOutCol = input.color(color.new(#B2B5BE, 75), "Outside VA · Бүсийн гадна", group = G2, tooltip = "Үнийн бүсийн гаднах TPO мөрийн өнгө.")
vaBoxCol = input.color(color.new(#FFFFFF, 92), "Value area fill · Бүсийн дэвсгэр", group = G2, tooltip = "VAH ба VAL хоорондын бүдэг дэвсгэр.")
pocCol = input.color(#E05252, "POC", group = G2, tooltip = "Хамгийн их TPO-той үнэ, хяналтын цэг.")
pocW = input.int(2, "POC width · POC зузаан", minval = 1, maxval = 4, group = G2, tooltip = "POC шугамын зузаан.")
vaLineCol = input.color(#9598A1, "VAH / VAL", group = G2, tooltip = "Үнийн бүсийн дээд ба доод хязгаарын өнгө.")
extLines = input.bool(true, "Extend POC/VAH/VAL · Түвшин сунгах", group = G2, tooltip = "Сүүлийн хаагдсан профайлын POC, VAH, VAL-ыг баруун ирмэгт богино шугамаар зурна.")
htfTpo = input.bool(true, "PW/PM on daily profile", group = G2, tooltip = "Өдрийн профайл дээр өмнөх долоо хоног (PW) ба өмнөх сарын (PM) VAH, POC, VAL түвшинг нэмнэ.")
singlesOn = input.bool(true, "Single prints · Нэг хэвлэл", group = G2, tooltip = "Зөвхөн нэг блок хүрч байсан үнийн мужийг ягаанаар дүүргэж, дахин хүрэх хүртэл сунгана.")
singleCol = input.color(#9C27B0, "Single color · Нэг хэвлэлийн өнгө", group = G2, tooltip = "Нэг хэвлэлийн ягаан дүүргэлт.")
singleExt = input.bool(true, "Extend until filled · Дүүртэл сунгах", group = G2, tooltip = "Нэг хэвлэлийг үнэ буцаж бүх мужийг туулах хүртэл баруун тийш сунгана.")
excessOn = input.bool(false, "Excess high/low · Илүүдэл", group = G2, tooltip = "Орой эсвэл ёроолд ганц TPO байвал илүүдэл гэж тэмдэглэнэ. Анхдагчаар унтарсан.")
poorOn = input.bool(false, "Poor high/low · Сул орой", group = G2, tooltip = "Орой эсвэл ёроолд 2 ба түүнээс олон TPO байвал дутуу аукцион. Анхдагчаар унтарсан.")
nPocOn = input.bool(true, "Naked POCs · Хөндөгдөөгүй POC", group = G2, tooltip = "Үнэ дахин хүрээгүй өмнөх POC-уудыг харуулна. Хүрвэл арилна.")
